# Fastfile for BibleAI Companion

default_platform(:ios)

platform :ios do

  desc "Create app in App Store Connect and set up IAP products"
  lane :setup_app_store do
    # Create app in App Store Connect
    produce(
      username: "shawncarpenter@mac.com",
      app_identifier: "com.shawncarpenter.bibleai-companion",
      app_name: "BibleAI Companion",
      language: "English",
      app_version: "1.0",
      sku: "bibleai-companion-001",
      team_name: "Stock Alarm" # or your team name
    )

    # Note: Fastlane doesn't have built-in IAP product creation
    # IAP products must be created manually or via App Store Connect API
    UI.success("✅ App created in App Store Connect!")
    UI.important("⚠️  You still need to manually create IAP products:")
    UI.message("1. Go to https://appstoreconnect.apple.com")
    UI.message("2. Select your app")
    UI.message("3. Go to Features > In-App Purchases")
    UI.message("4. Create these products:")
    UI.message("   - com.shawncarpenter.bibleai-companion.premium.monthly ($6.99/month)")
    UI.message("   - com.shawncarpenter.bibleai-companion.premium.yearly ($49.99/year)")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "BibleAI.xcodeproj")

    # Build the app
    build_app(
      scheme: "BibleAI",
      export_method: "app-store",
      output_directory: "./build"
    )

    # Upload to TestFlight
    upload_to_testflight(
      username: "shawncarpenter@mac.com",
      skip_waiting_for_build_processing: true
    )

    UI.success("✅ Build uploaded to TestFlight!")
  end

  desc "Archive the committed BibleAI version, verify the signed IPA and upload it"
  lane :beta_committed do |options|
    require 'json'
    require 'shellwords'
    require 'xcodeproj'
    root = File.expand_path('..', __dir__)
    shared = File.expand_path('~/projects/fastlane-configs/scripts')
    scheme = 'BibleAI'
    project = File.join(root, 'BibleAI.xcodeproj')
    version = options.fetch(:version).to_s
    build = options.fetch(:build).to_s
    args = ['ruby', File.join(shared, 'verify_release_source.rb'), '--project', project,
            '--version', version, '--build', build, '--ancestor', '57c7e65']
    source = JSON.parse(sh(Shellwords.join(args))).fetch('source_sha')
    signoff = File.join(root, 'docs', 'testing', "build#{build}-qa-signoff.md")
    UI.user_error!("Release QA sign-off required for build #{build}") unless File.file?(signoff)
    target = Xcodeproj::Project.open(project).targets.find { |t| t.name == scheme }
    release = target.build_configurations.find { |c| c.name == 'Release' }.build_settings
    bundle = release.fetch('PRODUCT_BUNDLE_IDENTIFIER')
    out = File.join(root, 'build', "candidate-#{version}-#{build}")
    ipa = build_app(
      workspace: File.join(root, 'BibleAI.xcworkspace'), scheme: scheme,
      export_method: 'app-store', output_directory: out, archive_path: File.join(out, 'BibleAI.xcarchive'),
      derived_data_path: File.join(root, 'build', 'reader'), xcargs: '-jobs 2',
      export_options: { signingStyle: 'manual', teamID: release.fetch('DEVELOPMENT_TEAM'),
                        manageAppVersionAndBuildNumber: false,
                        provisioningProfiles: { bundle => release.fetch('PROVISIONING_PROFILE_SPECIFIER') } }
    )
    sh(Shellwords.join(args + ['--expected-sha', source]))
    checks = [
      { plist_key: 'CFBundleIdentifier', contains: bundle },
      { plist_key: 'CFBundleVersion', contains: build },
      { plist_key: 'CFBundleShortVersionString', contains: version },
      { entitlement: 'com.apple.developer.applesignin' },
      { entitlement: 'com.apple.developer.ubiquity-kvstore-identifier' },
    ]
    sh(Shellwords.join(['ruby', File.join(shared, 'verify_ipa.rb'), '--ipa', ipa, '--spec-json', checks.to_json]))
    sh(Shellwords.join(['python3', File.join(root, 'scripts', 'verify-scripture-archive.py'), ipa]))
    transporter = '/Applications/Transporter.app/Contents/itms'
    ENV['FASTLANE_ITMS_TRANSPORTER_PATH'] ||= transporter if File.directory?(transporter)
    key = app_store_connect_api_key(key_id: '6T6GWQ6BW7', issuer_id: '69a6de83-d381-47e3-e053-5b8c7c11a4d1',
                                    key_filepath: File.expand_path('~/.appstoreconnect/private_keys/AuthKey_6T6GWQ6BW7.p8'))
    upload_to_testflight(ipa: ipa, app_identifier: bundle, api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Build and upload to App Store"
  lane :release do
    # Increment build number
    increment_build_number(xcodeproj: "BibleAI.xcodeproj")

    # Build the app
    build_app(
      scheme: "BibleAI",
      export_method: "app-store",
      output_directory: "./build"
    )

    # Upload to App Store
    upload_to_app_store(
      username: "shawncarpenter@mac.com",
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false
    )

    UI.success("✅ Build uploaded to App Store!")
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    snapshot
  end

  desc "Download metadata from App Store Connect"
  lane :download_metadata do
    download_metadata(
      username: "shawncarpenter@mac.com",
      app_identifier: "com.shawncarpenter.bibleai-companion"
    )
  end

  desc "Upload metadata to App Store Connect"
  lane :upload_metadata do
    upload_to_app_store(
      username: "shawncarpenter@mac.com",
      skip_binary_upload: true,
      skip_screenshots: true
    )
  end

  # Error handling
  error do |lane, exception|
    UI.error("❌ Error in lane #{lane}")
    UI.error(exception.message)
  end
end
